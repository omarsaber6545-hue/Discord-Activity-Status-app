<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme with Splash screen support -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_dark_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.DiscordActivity</item>
    </style>

    <style name="Theme.DiscordActivity" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/brand_dark_bg</item>
        <item name="android:navigationBarColor">@color/brand_dark_bg</item>
        <item name="android:windowBackground">@color/brand_dark_bg</item>
    </style>
</resources>
